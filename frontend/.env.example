# ============================================
# SalaFácil - Frontend Environment Variables
# ============================================

# API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=10000

# Application Settings
VITE_APP_NAME=SalaFácil
VITE_APP_VERSION=2.0.0
VITE_APP_DESCRIPTION=Sistema Profissional de Agendamento de Salas

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_GOOGLE_AUTH=false

# Google Integration (opcional)
VITE_GOOGLE_CLIENT_ID=sua-google-client-id-aqui

# Development Settings
VITE_DEBUG=true
VITE_MOCK_API=false

# Build Configuration
VITE_BUILD_PATH=dist
VITE_PUBLIC_PATH=/