# ============================================
# SalaFácil - Sistema de Agendamento de Salas
# Configurações de Ambiente
# ============================================

# ==================== BACKEND ====================
# Django Settings
DEBUG=True
SECRET_KEY=sua-chave-secreta-aqui-gere-uma-nova
DJANGO_SETTINGS_MODULE=backend.settings

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/salafacil
DB_NAME=salafacil
DB_USER=salafacil_user
DB_PASSWORD=senha_segura_aqui
DB_HOST=localhost
DB_PORT=5432

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# JWT Token Settings
JWT_SECRET_KEY=sua-jwt-secret-key-super-secreta
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ==================== FRONTEND ====================
# Vite Configuration
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=SalaFácil
VITE_APP_VERSION=2.0.0
VITE_APP_DESCRIPTION=Sistema Profissional de Agendamento de Salas

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true

# ==================== DEPLOY ====================
# Production Settings
ENVIRONMENT=development
NODE_ENV=development

# Netlify Functions (se usando Netlify)
NETLIFY=false
NETLIFY_SITE_ID=seu-site-id-netlify

# Database URL para Neon/Heroku/etc
DATABASE_URL_PRODUCTION=postgresql://usuario:senha@host:5432/database_name

# ==================== EXTERNAL SERVICES ====================
# Google Integration (opcional)
GOOGLE_CLIENT_ID=seu-google-client-id
GOOGLE_CLIENT_SECRET=seu-google-client-secret

# Email Settings (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
EMAIL_USE_TLS=true

# Push Notifications (opcional)
VAPID_PUBLIC_KEY=sua-vapid-public-key
VAPID_PRIVATE_KEY=sua-vapid-private-key

# ==================== INSTRUÇÕES ====================
# 1. Copie este arquivo para .env na raiz do projeto
# 2. Preencha os valores com suas configurações específicas
# 3. NUNCA commite o arquivo .env no Git (já está no .gitignore)
# 4. Para gerar SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 5. Para JWT_SECRET_KEY use uma string aleatória e segura de pelo menos 32 caracteres